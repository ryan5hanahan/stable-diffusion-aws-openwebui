# AWS Configuration
# IMPORTANT: us-west-2 is required for both Stability AI image models and most Bedrock LLMs
AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here  # Optional, for temporary credentials

# Stable Diffusion Model Configuration
# Available models (all require us-west-2 region):
#   - stability.sd3-5-large-v1:0       (SD 3.5 Large - best quality/speed balance)
#   - stability.stable-image-core-v1:1 (Stable Image Core - fast and affordable)
#   - stability.stable-image-ultra-v1:1 (Stable Image Ultra - photorealistic, premium)
SD_MODEL_ID=stability.sd3-5-large-v1:0

# LLM Gateway Configuration
# Default model for the Bedrock access gateway (optional)
# Examples: anthropic.claude-3-sonnet-20240229-v1:0, anthropic.claude-3-haiku-20240307-v1:0
# DEFAULT_MODEL=anthropic.claude-3-sonnet-20240229-v1:0

# API key shared between OpenWebUI and the gateway for authentication
# Can be any string — OpenWebUI sends it as a Bearer token, gateway validates it
OPENAI_API_KEY=dummy-key
